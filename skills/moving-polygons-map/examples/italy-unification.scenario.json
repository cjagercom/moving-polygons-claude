{
  "map": {
    "name": "Unification of Italy, 1859–1871",
    "description": "From a peninsula of seven states to one kingdom: the 1859 war with Austria, the annexation of central Italy, Garibaldi's Expedition of the Thousand, the proclamation of the Kingdom of Italy, Venetia in 1866 and Rome in 1870. Borders use modern provinces where they match the old states and Cliopatria outlines elsewhere; the County of Nice is approximated by Alpes-Maritimes. Sources: Wikipedia (Italian unification; Second Italian War of Independence; Expedition of the Thousand; Treaty of Turin 1860; Third Italian War of Independence; Capture of Rome).",
    "mapStyle": "light"
  },
  "scale": "regional",
  "bbox": [5.8, 36.5, 19.0, 47.2],
  "keyframes": [
    {"id": "K1", "date": "1859-01-01", "label": "1859 · Italy on the eve of war"},
    {"id": "K2", "date": "1859-07-11", "label": "Jul 1859 · Villafranca: Lombardy to Piedmont"},
    {"id": "K3", "date": "1860-03-24", "label": "Mar 1860 · Centre joins; Nice and Savoy to France"},
    {"id": "K4", "date": "1860-09-07", "label": "Sep 1860 · Garibaldi enters Naples"},
    {"id": "K5", "date": "1861-03-17", "label": "Mar 1861 · Kingdom of Italy proclaimed"},
    {"id": "K6", "date": "1866-10-12", "label": "Oct 1866 · Treaty of Vienna: Venetia to Italy"},
    {"id": "K7", "date": "1870-09-20", "label": "Sep 1870 · Capture of Rome"},
    {"id": "K8", "date": "1871-07-01", "label": "Jul 1871 · Rome becomes the capital"}
